// Example assembly: one coding loop with author/verifier roles, capability
// requirements with the degradation ladder, adapter bindings onto host-native
// assets, and a deployment target whose adapter exposes the required tools.

skill impact-analysis {
  description "Before editing, map the blast radius of the change and list affected modules."
  permissions {
    workspace read
  }
}

skill verification-before-complete {
  description "Do not declare the task complete until verification evidence (tests or diff review) exists."
  permissions {
    workspace read
    network deny
  }
}

workflow coding-loop {
  author -> verifier
  on verifier.failed -> author
  stop when verifier.passed
}

harness standard-coding {
  workflow coding-loop

  agent author {
    use skill impact-analysis
    require tool workspace.read
    require tool workspace.write
  }

  agent verifier {
    use skill verification-before-complete {
      preferred enforced
      minimum advisory
      on-degrade report
    }
    require tool process.exec
  }

  configure {
    shell.timeout = 60s
    tool-call-budget = 80
  }
}

target qoder uses adapter.qoder
